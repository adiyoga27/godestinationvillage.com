<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # --- URL KANONIK: https://godevi.org (tanpa www) ---
    # Domain lama & www -> godevi.org, path + query ikut (301 per-path, bukan ke homepage).
    RewriteCond %{HTTP_HOST} ^(www\.)?godestinationvillage\.com$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^www\.godevi\.org$ [NC]
    RewriteRule ^(.*)$ https://godevi.org/$1 [R=301,L]

    # http -> https (hanya host produksi, supaya dev lokal tidak ikut ter-redirect)
    RewriteCond %{HTTP_HOST} ^godevi\.org$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(.*)$ https://godevi.org/$1 [R=301,L]

    # Varian /index.php dan /index.php/... -> URL bersih. THE_REQUEST = request asli
    # dari browser, jadi rewrite internal ke index.php di bawah tidak ikut ter-redirect.
    RewriteCond %{HTTP_HOST} ^godevi\.org$ [NC]
    RewriteCond %{THE_REQUEST} \s/+index\.php(/[^\s?]*)?[\s?] [NC]
    RewriteRule ^index\.php(?:/(.*))?$ https://godevi.org/$1 [R=301,L]
    # ---------------------------------------------------------------------------

    # --- PROTEKSI TAMBAHAN ---
    # Blokir akses ke file .env, .git, .log, dll
    RewriteRule ^(\.env|\.git|\.config|composer\.(json|lock)|package\.json)$ - [F,L]
    
    # Blokir akses ke folder storage/logs secara langsung
    RewriteRule ^storage/logs/(.*)$ - [F,L]
    # -------------------------

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Salinan/staging di host lain (mis. *.codingaja.com) tidak boleh terindeks.
<IfModule mod_headers.c>
    SetEnvIfNoCase Host "^godevi\.org$" GODEVI_PRIMARY_HOST
    Header always set X-Robots-Tag "noindex, nofollow" env=!GODEVI_PRIMARY_HOST
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
